NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Public URL of this API (used to build upload URLs)
PUBLIC_API_URL=http://localhost:4000
# Frontend URL (used for payment redirects)
FRONTEND_URL=http://localhost:3100

DB_HOST=localhost
DB_PORT=5440
DB_USER=cholo
DB_PASSWORD=cholo_dev_password
DB_NAME=cholo_market
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6380

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Steadfast courier API (shops add their own Api-Key / Secret-Key in Settings → Delivery)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# In development the OTP is returned in the API response (devCode) and logged.
OTP_TTL_SECONDS=300
